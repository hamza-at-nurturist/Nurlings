{
  "name": "@nurlings/brand",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./brand.json": "./brand.json",
    "./schema": "./src/schema.ts",
    "./chief-avatar": "./src/chief-avatar.ts",
    "./text": "./src/text.ts",
    "./guard": "./src/guard.ts",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/brand/src",
    "brand:check": "tsx scripts/brand-check.ts",
    "make:sources": "tsx scripts/render-sources.ts",
    "export:assets": "tsx scripts/export-assets.ts"
  },
  "devDependencies": {
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vitest": "4.1.12"
  }
}
